+        "    .reset_index()\n",
+        "    .pivot(index=\"fold\", columns=\"model\", values=\"balanced_accuracy\")\n",
+        ")\n",
+        "display(fold_table.style.format(\"{:.3f}\").set_caption(\"Balanced accuracy by walk-forward fold\"))\n"
+      ]
