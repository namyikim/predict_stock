+      "source": [
+        "## 6.5 OOF 스태킹 앙상블\n",
+        "\n",
+        "워크포워드에서 나온 각 모델의 out-of-fold(OOF) 확률을 입력으로 다항 로지스틱 메타모델을 학습합니다. 메타모델도 시간 순서를 지켜 **이전 폴드들의 OOF로만 학습하고 다음 폴드를 예측**하므로 스태킹 자체가 미래 정보를 쓰지 않습니다. 로그확률을 입력으로 쓰기 때문에 메타모델은 각 기본모델의 과신/과소신을 보정(calibration)하는 역할도 겸합니다. 비교용으로 단순 평균 앙상블도 함께 계산합니다.\n"
+      ]
+    },
+    {
+      "cell_type": "code",
+      "metadata": {},
+      "execution_count": null,
+      "outputs": [],
+      "source": [
+        "STACK_BASE_MODELS = [\"Logistic\", \"LightGBM\", \"Transformer\"]\n",
+        "STACK_MIN_TRAIN_ROWS = 120\n",
+        "\n",
+        "\n",
+        "def stacking_matrix(frame, models):\n",
+        "    \"\"\"모델별 OOF 확률을 (date × [model×class]) 로그확률 행렬로 변환한다.\"\"\"\n",
+        "    wide = (\n",
+        "        frame[frame[\"model\"].isin(models)]\n",
+        "        .pivot_table(index=\"date\", columns=\"model\", values=PROB_COLS)\n",
+        "        .dropna()\n",
+        "    )\n",
+        "    cols = [(p, m) for m in models for p in PROB_COLS]\n",
+        "    Z = np.log(np.clip(wide[cols].to_numpy(dtype=float), 1e-6, 1.0))\n",
+        "    return pd.DatetimeIndex(wide.index), Z\n",
+        "\n",
+        "\n",
+        "def make_meta_model():\n",
+        "    return LogisticRegression(C=0.5, max_iter=3000, class_weight=\"balanced\", random_state=SEED)\n",
+        "\n",
+        "\n",
+        "oof_dates, oof_Z = stacking_matrix(predictions, STACK_BASE_MODELS)\n",
+        "oof_y = model_df.loc[oof_dates, \"target\"].to_numpy(dtype=int)\n",
+        "fold_by_date = (\n",
+        "    predictions[predictions[\"model\"] == \"Logistic\"].set_index(\"date\")[\"fold\"].reindex(oof_dates)\n",
+        ")\n",
+        "\n",
+        "stacked_rows = []\n",
+        "for fold in folds:\n",
+        "    fold_id = fold[\"fold\"]\n",
+        "    test_mask = (fold_by_date == fold_id).to_numpy()\n",
+        "    train_mask = (fold_by_date < fold_id).to_numpy()\n",
+        "    if train_mask.sum() < STACK_MIN_TRAIN_ROWS or test_mask.sum() == 0:\n",
+        "        continue\n",
+        "    meta = make_meta_model().fit(oof_Z[train_mask], oof_y[train_mask])\n",
+        "    p_meta = meta.predict_proba(oof_Z[test_mask])[:, np.argsort(meta.classes_)]\n",
+        "    stacked_rows.append(prediction_frame(\n",
+        "        \"Stacked\", oof_dates[test_mask], oof_y[test_mask], p_meta, fold_id\n",
+        "    ))\n",
+        "\n",
+        "    # 비교용: 세 모델 확률의 단순 평균\n",
+        "    p_mean = np.exp(oof_Z[test_mask]).reshape(test_mask.sum(), len(STACK_BASE_MODELS), 3).mean(axis=1)\n",
+        "    stacked_rows.append(prediction_frame(\n",
+        "        \"Mean ensemble\", oof_dates[test_mask], oof_y[test_mask], p_mean, fold_id\n",
+        "    ))\n",
+        "\n",
+        "if stacked_rows:\n",
+        "    stacked_predictions = pd.concat(stacked_rows, ignore_index=True)\n",
+        "    predictions = pd.concat([predictions, stacked_predictions], ignore_index=True)\n",
+        "    print(f\"Stacked OOF rows: {int((stacked_predictions['model'] == 'Stacked').sum())} \"\n",
+        "          f\"(첫 폴드는 메타모델 학습 데이터가 없어 제외)\")\n",
+        "    display(summarize_predictions(predictions).style.format(\"{:.4f}\"))\n",
+        "else:\n",
+        "    print(\"⚠️ 스태킹에 필요한 폴드가 부족합니다. QUICK_MODE=False로 폴드를 늘리세요.\")\n",
+        "\n",
+        "# 최신 예측용: 전체 OOF로 메타모델을 한 번 더 학습한다.\n",
